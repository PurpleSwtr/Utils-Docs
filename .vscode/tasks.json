{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mkdocs-yml-create",
      "type": "shell",
      "command": "python",
      "args": ["utils/utils.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Frontend",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "problemMatcher": [],
      "presentation": {
        "group": "dev-servers",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Backend",
      "type": "shell",
      "command": "uvicorn api.main:app --reload",
      "problemMatcher": [],
      "presentation": {
        "group": "dev-servers",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Fullstack",
      "dependsOn": ["Run Frontend", "Run Backend"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
